{
  "expo": {
    "name": "Rumbo",
    "slug": "rumbo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "rumbo",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Rumbo usa tu ubicación para dibujar el recorrido mientras el rastreo está activo."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D1524",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Rumbo usa tu ubicación para dibujar el recorrido mientras el rastreo está activo."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0D1524",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ]
  }
}
